# مفتاح RadoxAI (https://radoxai.com) — اختياري هنا: تقدر تحطه من صفحة الإعدادات بالموقع بدلاً منه
RADOX_API_KEY=
RADOX_BASE_URL=https://radoxai.com/v1

# مجلد مهارات Claude (افتراضياً %USERPROFILE%\.claude\skills) — منه تنسحب المحركات والخطوط والشعارات
SKILLS_DIR=

# كروم/إيدج للتصدير بدقة المهارات (اختياري — يكتشفه تلقائياً على ويندوز)
CHROME_PATH=

# بايثون المهارات للقص المحلي (فوتوشوب + BiRefNet) — اختياري
PYTHON_CMD=py -3.11
